{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "portuguese-with-ines-www-redirect",
  "main": "index.mjs",
  "compatibility_date": "2026-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "www.portuguesewithines.com",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
