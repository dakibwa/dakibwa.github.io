# Cloudflare Pages response headers.
#
# Without this file Pages serves everything with `max-age=14400, must-revalidate`,
# which makes the browser re-check the fonts, CSS and JS on every visit once four
# hours have passed. Everything under /_next/static/ carries a content hash in its
# filename, so a changed file is always a different URL and the old one can be
# cached indefinitely.

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Production assets are referenced by stable paths, so they cannot be immutable.
# A day of browser caching with revalidation keeps repeat visits cheap without
# stranding an updated image behind a long TTL.
/visuals/*
  Cache-Control: public, max-age=86400, must-revalidate

/icon.svg
  Cache-Control: public, max-age=86400, must-revalidate

# HTML pages: 10-minute browser cache with revalidation. Short enough to pick up
# deploys within minutes, long enough to skip re-fetch on quick return visits.
/
  Cache-Control: public, max-age=600, must-revalidate

/approach/
  Cache-Control: public, max-age=600, must-revalidate

/lessons/
  Cache-Control: public, max-age=600, must-revalidate

/faq/
  Cache-Control: public, max-age=600, must-revalidate

/book/
  Cache-Control: public, max-age=600, must-revalidate

# The account pages were missing from this list entirely, so they fell back to
# the Pages default of four hours — a deploy took that long to reach anyone
# already carrying the old shell. Their contents come from the API at runtime,
# so this is about the page itself catching up, not the lessons in it.
/my-lessons/
  Cache-Control: public, max-age=600, must-revalidate

/booking/
  Cache-Control: public, max-age=600, must-revalidate

/schedule/
  Cache-Control: public, max-age=600, must-revalidate

/reset-password/
  Cache-Control: public, max-age=600, must-revalidate
